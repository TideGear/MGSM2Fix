 typedef struct PreMet1Prims
 {
diff --git a/source/onoda/preope/pre_met2.c b/source/onoda/preope/pre_met2.c
index 29e3ca4..f9993e0 100644
--- a/source/onoda/preope/pre_met2.c
+++ b/source/onoda/preope/pre_met2.c
@@ -16,7 +16,7 @@
 /*---------------------------------------------------------------------------*/
 
 #define EXEC_LEVEL  GV_ACTOR_USER
-#define PAGE_COUNT  14
+#define PAGE_COUNT  19
 
 typedef struct PreMet2Prims
 {
diff --git a/source/onoda/preope/preope.c b/source/onoda/preope/preope.c
index 003bda4..45db8ea 100644
--- a/source/onoda/preope/preope.c
+++ b/source/onoda/preope/preope.c
@@ -16,6 +16,8 @@
 #define EXEC_LEVEL GV_ACTOR_MANAGER
 
 // FIXME: it's the same struct as in change.c (in change overlay)
+#define MG2_RECAP_OFFSET 22029
+
 typedef struct _Unknown
 {
     SPRT  text_sprt[2];
@@ -46,8 +48,8 @@ typedef struct _Work
     char     pad378[0x14];
     DR_TPAGE field_38C;
     Unknown  field_394[4];
-    Unknown  field_714[72];
-    Unknown  field_4614[112];
+    Unknown  field_714[12 * 8];
+    Unknown  field_4614[19 * 8];
     int      field_A814;
     int      field_A818;
     int      clut_x;
@@ -820,7 +822,7 @@ static int GetResources(Work *work, int map)
     }
 
     index = 0;
-    for (j = 0; j < 9; j++)
+    for (j = 0; j < 12; j++)
     {
         for (i = 0; i < 8; i++)
         {
@@ -829,13 +831,21 @@ static int GetResources(Work *work, int map)
         }
     }
 
-    index = 0;
-    for (j = 0; j < 14; j++)
+    /* Metal Gear 2's lines sit in the script chunk past the end of the script,
+       as NUL terminated strings: both recaps' text together overflows the GCL
+       chain's size ceiling, and the overlay loads at a fixed address so it
+       cannot hold them either.  field_394[0].string is the payload of the
+       chain's first record, so the run is a fixed distance from it. */
     {
-        for (i = 0; i < 8; i++)
+        const char *p = work->field_394[0].string - 2 + MG2_RECAP_OFFSET;
+
+        for (index = 0; index < 19 * 8; index++)
         {
-            work->field_4614[index].string = GCL_GetString(GCL_NextStr());
-            index++;
+            work->field_4614[index].string = (char *)p;
+
+            while (*p++ != '␀')
+            {
+            }
         }
     }
 
@@ -854,6 +864,15 @@ static int GetResources(Work *work, int map)
 
 /*---------------------------------------------------------------------------*/
 
+/* Keeps NewPreviousOperation at the fixed 0x800C4DA4 the main executable
+   calls.  Never called. */
+volatile int preope_reserved_sink;
+
+void preope_reserved(int n)
+{
+    preope_reserved_sink = n + 1;
+}
+
 void *NewPreviousOperation(int name, int where, int argc, char **argv)
 {
     Work *work;
